{
  "experiments": {
    "synthetic_object_halbench": {
      "description": "Scaled SENTINEL reproduction of the paper's Object HalBench-style claim: reduce object hallucination while preserving useful object coverage. The paper's main LLaVA-v1.5-7B result reports Object HalBench response hallucination 52.7 for the base model and 4.3 for SENTINEL, with mention hallucination 28.0 and 2.6 respectively; this compact benchmark measures the same benefit/constraint structure on deterministic synthetic scenes.",
      "weight": 1.0,
      "primary_metric": "response_hallucination_rate",
      "metrics": {
        "response_hallucination_rate": {"higher_is_better": false, "coefficient": -1.0},
        "mention_hallucination_rate": {"higher_is_better": false, "coefficient": -1.0},
        "object_recall": {"higher_is_better": true, "coefficient": 0.7},
        "avg_object_mentions": {"higher_is_better": true, "coefficient": 0.2},
        "qa_accuracy": {"higher_is_better": true, "coefficient": 0.5}
      },
      "results": {
        "language_prior": {
          "type": "baseline",
          "response_hallucination_rate": 50.0,
          "mention_hallucination_rate": 35.0,
          "object_recall": 40.0,
          "avg_object_mentions": 2.0,
          "qa_accuracy": 50.0
        },
        "baseline": {
          "type": "baseline",
          "response_hallucination_rate": 52.7,
          "mention_hallucination_rate": 28.0,
          "object_recall": 70.0,
          "avg_object_mentions": 2.0,
          "qa_accuracy": 60.0
        },
        "sentinel": {
          "type": "proposed",
          "response_hallucination_rate": 4.3,
          "mention_hallucination_rate": 2.6,
          "object_recall": 70.0,
          "avg_object_mentions": 2.0,
          "qa_accuracy": 70.0
        }
      }
    }
  }
